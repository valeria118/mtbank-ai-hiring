# === LLM backend (любой OpenAI-совместимый провайдер) ===
# Groq / Together / OpenRouter / локальный vLLM — что угодно с OpenAI-совместимым /v1
# Актуальный список моделей Groq: https://console.groq.com/docs/models
# (llama-3.3-70b-versatile снята с обслуживания Groq на момент подготовки решения)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=openai/gpt-oss-120b

# === ASR (faster-whisper) ===
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
# Батчинг ускоряет транскрибацию на GPU. На CPU игнорируется.
WHISPER_BATCH_SIZE=8

# === Диаризация моно-записей (стерео всегда разделяется по каналам,
# эта настройка на них не влияет) ===
# Сам pyannote.audio в образ по умолчанию НЕ ставится — он тянет torch и
# добавляет ~1.8 ГБ к образу ради выключенной по умолчанию функции. Чтобы он
# появился в образе, соберите стенд с WITH_PYANNOTE=true (переменная ниже
# пробрасывается в docker compose как build-arg, см. requirements-pyannote.txt).
# Без неё режим auto молча работает на эвристике по паузам, а режим pyannote
# честно падает с ошибкой импорта.
WITH_PYANNOTE=false
#
# auto            — pyannote, если ниже задан HF_TOKEN и образ собран с
#                    WITH_PYANNOTE=true; иначе эвристика по паузам (без
#                    дополнительной настройки, но менее точная на реальных,
#                    не синтезированных звонках)
# pyannote        — только pyannote.audio; падать с ошибкой, если недоступен
#                    (не установлен/нет токена/нет сети/не приняты условия
#                    доступа к модели)
# pause_heuristic — только эвристика по паузам, без тяжёлых torch-зависимостей
DIARIZATION_BACKEND=auto
# Токен HuggingFace для gated-моделей pyannote:
# 1) создать на https://hf.co/settings/tokens (Read достаточно; у fine-grained
#    токена нужно право repo.content.read)
# 2) принять условия доступа, залогинившись ТЕМ ЖЕ аккаунтом, на ТРЁХ
#    страницах — pyannote.audio 4.x тянет их все, одной 3.1 недостаточно:
#      https://huggingface.co/pyannote/speaker-diarization-3.1
#      https://huggingface.co/pyannote/segmentation-3.0
#      https://huggingface.co/pyannote/speaker-diarization-community-1
#        (PLDA-трансформ; появился в зависимостях пайплайна в 4.x, в 3.x его
#         не было — на нём спотыкаешься уже после первых двух)
#    Что принято, видно на https://huggingface.co/settings/gated-repos
# Без выполнения шага 2 Pipeline.from_pretrained() вернёт 403 GatedRepoError
# (в некоторых версиях — тихо None) даже с валидным токеном.
# Значение, не похожее на токен (оставленный плейсхолдер, кириллица, забытые
# кавычки), config.py считает отсутствием токена и убирает из окружения:
# huggingface_hub читает HF_TOKEN для ЛЮБОЙ загрузки, включая модель
# faster-whisper, и мусор здесь ронял бы транскрибацию, а не диаризацию.
HF_TOKEN=

# === API ===
API_HOST=0.0.0.0
API_PORT=8080
MAX_AUDIO_DURATION_SEC=600
# Префикс, под которым API виден снаружи, если перед ним стоит обратный
# прокси. Для локального запуска — пусто. В прод-оверлее
# (docker-compose.prod.yml) выставляется в /api: Caddy отдаёт чат на «/», а
# API на «/api», и без этого Swagger просит схему не по тому адресу.
API_ROOT_PATH=

# === Хранилище результатов (SQLite) ===
DB_PATH=data/calls.db

# === OpenWebUI Pipelines ===
PIPELINES_API_KEY=0p3n-w3bu!
OPENWEBUI_BASE_URL=http://openwebui:8080
# Вложения чата читаются с общего тома (OPENWEBUI_UPLOADS_DIR), поэтому токен
# обычно не нужен. Он используется только как запасной путь по HTTP — если том
# не смонтирован. Учтите: /api/v1/files/{id}/content требует авторизацию даже
# при WEBUI_AUTH=false (OpenWebUI 0.11), так что без тома здесь нужен реальный
# ключ (Settings -> Account -> API keys в OpenWebUI).
OPENWEBUI_API_KEY=
# Каталог вложений OpenWebUI внутри контейнера pipelines (см. docker-compose.yml).
OPENWEBUI_UPLOADS_DIR=/openwebui-data/uploads

# === Real-time WebSocket (бонус) ===
REALTIME_SAMPLE_RATE=16000
REALTIME_WINDOW_SEC=2.5

# === Grafana (бонус) ===
GRAFANA_PASSWORD=admin
# Отдельный экспортёр /metrics внутри процесса пайплайна. Включён в образе
# pipelines (ENV в Dockerfile.pipelines) и не нужен сервису api — там метрики
# отдаёт сам FastAPI на /metrics. Без него анализ из чата — главный сценарий
# ТЗ — не виден в Grafana: счётчики живут в памяти процесса pipelines.
METRICS_EXPORTER_ENABLED=false
METRICS_PORT=9100

# === Публичное демо (docker-compose.prod.yml, см. docs/deployment.md) ===
# Доменное имя, на которое Caddy выпускает сертификат Let's Encrypt.
# Голый IP не подойдёт — LE на IP сертификаты не выдаёт. Бесплатные
# варианты имени: DuckDNS или <ip-через-дефисы>.sslip.io.
DEMO_HOSTNAME=

# === Логирование ===
LOG_LEVEL=INFO
LOG_JSON=true
# Обрезка входа/выхода агента в JSON-логах, в символах. 0 — не резать.
# ТЗ требует логировать вход и выход каждого агента; обрезанный вход
# пятиминутного звонка этому требованию не отвечает, поэтому дефолт — 0.
# Ставьте ненулевое значение, только если объём логов важнее полноты; факт
# обрезки при этом попадает в лог отдельным полем.
LOG_TRUNCATE_CHARS=0
